{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": [
    "src/app/**/*.ts",
    "src/app/**/*.tsx",
    "components/**/*.ts",
    "components/**/*.tsx",
    "packages/**/*.ts",
    "packages/**/*.tsx",
    "expo-env.d.ts"
  ],
  "exclude": ["node_modules", "dist", "src"]
}
