{
  "name": "orbifold-play",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build:web": "expo export -p web",
    "postinstall": "node copy-canvaskit.cjs",
    "test": "vitest run --config vitest.config.mts packages",
    "lint": "eslint src/app components packages",
    "typecheck": "tsc --noEmit",
    "format": "prettier --check src/app components packages ORBIFOLD_PLAY_BRIEF.md docs/mobile-play"
  },
  "dependencies": {
    "@shopify/react-native-skia": "2.6.2",
    "@strudel/web": "1.0.3",
    "expo": "57.0.1",
    "expo-blur": "57.0.2",
    "expo-haptics": "57.0.1",
    "expo-linking": "57.0.1",
    "expo-router": "57.0.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.0",
    "react-native-reanimated": "4.5.0",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "4.25.2",
    "react-native-web": "0.21.0",
    "react-native-worklets": "0.10.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/react": "19.2.17",
    "eslint": "10.0.1",
    "prettier": "3.9.5",
    "typescript": "5.9.3",
    "typescript-eslint": "8.64.0",
    "vitest": "2.1.8"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@shopify/react-native-skia",
      "esbuild"
    ]
  }
}
