{
  "_comment": "Permissions tuned to minimize permission fatigue. The methodology's review checkpoints are the real safety net; permissions are keyboard convenience. Read-only and project-internal writes are pre-approved. Only network/state changes outside the repo and irreversible operations require Pilot decision. Customize per project — see CLAUDE.md 'Permission tuning'.",

  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git stash list:*)",
      "Bash(git stash show:*)",
      "Bash(git remote:*)",
      "Bash(git fetch:*)",
      "Bash(git add:*)",
      "Bash(git checkout:*)",
      "Bash(git restore:*)",
      "Bash(git stash:*)",
      "Bash(git switch:*)",
      "Bash(ls:*)",
      "Bash(find:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(file:*)",
      "Bash(stat:*)",
      "Bash(du:*)",
      "Bash(df:*)",
      "Bash(pwd)",
      "Bash(echo:*)",
      "Bash(which:*)",
      "Bash(env)",
      "Bash(date)",
      "Bash(mkdir:*)",
      "Bash(touch:*)",
      "Bash(cp:*)",
      "Bash(mv:*)",
      "Bash(npm test:*)",
      "Bash(npm run:*)",
      "Bash(pnpm test:*)",
      "Bash(pnpm run:*)",
      "Bash(pnpm dev:*)",
      "Bash(pnpm build:*)",
      "Bash(pnpm lint:*)",
      "Bash(pnpm exec:*)",
      "Bash(pnpm dlx:*)",
      "Bash(npx tsc:*)",
      "Bash(npx jest:*)",
      "Bash(npx vitest:*)",
      "Bash(npx eslint:*)",
      "Bash(npx prettier:*)",
      "Bash(yarn test:*)",
      "Bash(yarn run:*)",
      "Bash(pytest:*)",
      "Bash(python -m pytest:*)",
      "Bash(python -m unittest:*)",
      "Bash(python:*)",
      "Bash(python3:*)",
      "Bash(ruff:*)",
      "Bash(mypy:*)",
      "Bash(cargo test:*)",
      "Bash(cargo check:*)",
      "Bash(cargo build:*)",
      "Bash(cargo clippy:*)",
      "Bash(cargo fmt:*)",
      "Bash(go test:*)",
      "Bash(go build:*)",
      "Bash(go vet:*)",
      "Bash(make:*)",
      "Read(*)",
      "Glob(*)",
      "Grep(*)",
      "Write(docs/**)",
      "Edit(docs/**)",
      "Write(src/app/**)",
      "Edit(src/app/**)",
      "Write(packages/**)",
      "Edit(packages/**)",
      "Write(components/**)",
      "Edit(components/**)",
      "Write(pages/**)",
      "Edit(pages/**)",
      "Write(.claude/**)",
      "Edit(.claude/**)",
      "Write(public/**)",
      "Edit(public/**)",
      "Write(package.json)",
      "Edit(package.json)",
      "Write(tsconfig*.json)",
      "Edit(tsconfig*.json)",
      "Write(*.config.*)",
      "Edit(*.config.*)",
      "Write(.eslintrc*)",
      "Edit(.eslintrc*)",
      "Write(eslint.config.*)",
      "Edit(eslint.config.*)",
      "Write(.prettierrc*)",
      "Edit(.prettierrc*)",
      "Write(.prettierignore)",
      "Write(.gitignore)",
      "Edit(.gitignore)",
      "Write(LICENSE)",
      "Write(README.md)",
      "Edit(README.md)",
      "Write(AGENTS.md)",
      "Edit(AGENTS.md)",
      "Write(CLAUDE.md)",
      "Edit(CLAUDE.md)",
      "Write(ORBIFOLD_PLAY_BRIEF.md)",
      "Edit(ORBIFOLD_PLAY_BRIEF.md)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean -fd:*)",
      "Bash(rm -rf:*)",
      "Bash(rm -rf /:*)",
      "Bash(sudo rm:*)",
      "Bash(npm publish:*)",
      "Bash(yarn publish:*)",
      "Bash(cargo publish:*)",
      "Bash(twine upload:*)",
      "Bash(terraform apply:*)",
      "Bash(terraform destroy:*)",
      "Bash(kubectl delete:*)",
      "Bash(kubectl apply -f:*)",
      "Bash(aws s3 rm:*)",
      "Bash(aws s3 rb:*)",
      "Bash(gcloud:*)",
      "Bash(heroku:*)",
      "Bash(fly deploy:*)",
      "Bash(vercel deploy:*)",
      "Bash(netlify deploy:*)",
      "Bash(railway up:*)",
      "Bash(curl -X POST:*)",
      "Bash(curl -X PUT:*)",
      "Bash(curl -X DELETE:*)"
    ],
    "ask": [
      "Bash(git merge:*)",
      "Bash(git commit:*)",
      "Bash(git rebase:*)",
      "Bash(git cherry-pick:*)",
      "Bash(git push:*)",
      "Bash(npm install:*)",
      "Bash(pnpm install:*)",
      "Bash(pnpm add:*)",
      "Bash(yarn add:*)",
      "Bash(yarn install:*)",
      "Bash(cargo add:*)",
      "Bash(pip install:*)",
      "Bash(pip3 install:*)",
      "Bash(uv add:*)",
      "Bash(brew install:*)",
      "Bash(go get:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/escalate-on-adr.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/escalate-on-destructive.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/notify-on-blocker.sh"
          },
          {
            "type": "command",
            "command": ".claude/hooks/notify-on-inventory.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/notify-phase-done.sh"
          }
        ]
      }
    ]
  }
}
